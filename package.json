{
  "name": "web-wallet",
  "version": "0.22.0-alpha.0",
  "private": true,
  "description": "Unification Mainchain Web Wallet",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "yarn lingui:extract",
    "dev": "vite",
    "prebuild": "yarn lingui:extract",
    "build": "tsc -b && vite build",
    "prebuild:web": "yarn lingui:extract",
    "build:web": "tsc -b && vite build --mode web",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile --typescript",
    "lingui:check": "lingui extract --clean --overwrite && git diff --exit-code src/locales/",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "eslint --max-warnings 0",
    "*.{json,md,yml,yaml}": []
  },
  "dependencies": {
    "@cosmjs/amino": "^0.38.0",
    "@cosmjs/crypto": "^0.38.0",
    "@cosmjs/encoding": "^0.38.0",
    "@cosmjs/proto-signing": "^0.38.0",
    "@cosmjs/stargate": "^0.38.0",
    "@hookform/resolvers": "^3.9.1",
    "@lingui/core": "^6.0.1",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^6.0.1",
    "@noble/hashes": "^1.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.62.7",
    "@unification-com/fundjs-react": "link:../fundjs/packages/fundjs-react/dist",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@eslint/js": "^9.17.0",
    "@lingui/cli": "^6.0.1",
    "@lingui/format-po": "^6.0.1",
    "@lingui/vite-plugin": "^6.0.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "comments": {
    "fundjs-react": "Linked to local ../fundjs/packages/fundjs-react/dist for now; swap to npm registry once Stage 10 publishes @unification-com/fundjs-react@^0.2.0. Run 'yarn build' inside ../fundjs/packages/fundjs-react when fundjs source changes — symlink picks it up automatically.",
    "router": "@tanstack/react-router added when multiple routes appear (likely mid-M1 or M2)",
    "ledger": "@ledgerhq/{hw-app-cosmos,hw-transport-webhid} added in M8 (conditional — review at M7 close)",
    "cosmjs-amino": "@cosmjs/amino kept alongside proto-signing for amino-mode (Ledger paths in M8 + v1-keystore single-key signers in M1.5)"
  }
}
